{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bylaw_verify_evidence.schema.json",
  "title": "bylaw-verify input: evidence units",
  "description": "Source text each candidate cites (evidence_units.json). Extra fields are allowed and passed through.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["evidence_id", "evidence_text", "page"],
    "properties": {
      "evidence_id": {"type": "string", "minLength": 1},
      "evidence_text": {"type": "string"},
      "page": {"type": ["integer", "null"]},
      "section": {"type": ["string", "null"]},
      "evidence_type": {"type": ["string", "null"]}
    }
  }
}
